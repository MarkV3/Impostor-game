# The game and Socket.IO share this port. Hosting updates the forwarding rule.
PORT=8080

# Render sets its own PORT and public URL automatically.
# Optional overrides for other hosting providers or a custom domain:
# HOST=0.0.0.0
# PUBLIC_URL=https://your-game.onrender.com

# Required for `npm run host` and `npm run tunnel`.
# Save your existing tunnel token with `npm run configure:tunnel`.
CLOUDFLARE_TUNNEL_TOKEN=
